{% assign all_products = collections.all.products %}
      <div class="collection page-width">
        <ul id="Huratips-Loop" data-id="{{ section.id }}" class="
          grid grid--2-col negative-margin product-grid
          {% if collection.products_count < 4 %} grid--{{ collection.products_count }}-col-tablet{% else %}
            {% if collection.products_count == 4 %} grid--4-col-desktop{% else %} grid--3-col-tablet grid--one-third-max grid--4-col-desktop grid--quarter-max{% endif %}
          {% endif %}">
 {%- for product in all_products -%}
            <li class="grid__item">
              {% render 'product-card',
                product_card_product: product,
                media_size: section.settings.image_ratio,
                show_secondary_image: section.settings.show_secondary_image,
                add_image_padding: section.settings.add_image_padding,
                show_vendor: section.settings.show_vendor,
                show_image_outline: section.settings.show_image_outline,
                show_rating: section.settings.show_rating
              %}
            </li>
          {%- endfor -%}
        </ul>

        <div class="static-bundle-wrapper" disabled="disabled">Add bundle</div>
      </div>

<style>
  .static-bundle-wrapper{
    position: fixed;
    bottom: 0;
    background: red;
    color: #fff;
    left: 0;
    right: 0;
    text-align: center;
    padding: 10px;
    cursor:pointer;    
  }
  .add-bundle-product[disabled] ,.static-bundle-wrapper[disabled]{
  background-color: grey; 
  color: #aaa; 
  cursor: not-allowed; 
  pointer-events: none; 
}
</style>
<script>

$(document).ready(function() {
  let bundleData = [];
  $('.add-bundle-product').on('click', function(e) {
    $(this).attr('disabled', 'disabled'); 
    e.preventDefault(); 

    let variantId = $(this).attr('data-variant-id');
    
    bundleData.push({
      variant_id: variantId,
      quantity: 1
    });

    console.log('Current bundleData: ', bundleData); 

    if(bundleData.length >= 3){
      $('.add-bundle-product').attr('disabled', 'disabled');    
      $('.static-bundle-wrapper').removeAttr('disabled'); 
    }
  });

  $('.static-bundle-wrapper').on('click', function(e) {
    e.preventDefault(); 

    if(bundleData.length === 0) {
      console.log("No items selected");
      return;
    }

    console.log('Adding products to cart:', bundleData); 
    
    let items = bundleData.map(function(item) {
        let currentTime = Date.now()
      return {
        id: item.variant_id, 
        quantity: item.quantity,
        properties: {
          current_time: currentTime  
        }
      };
    });

    $.ajax({
      type: 'POST',
      url: '/cart/add.js',
      data: {
        items: items,  
      },
      dataType: 'json',
      success: function(response) {
        console.log('Added to cart ', response); 
        setTimeout(function() {
          window.location.href = '/cart'; 
        }, 3000);
      },
      error: function(response) {
        console.log('Error to cart ', response); 
      }
    });
  });



  
  
});


  
